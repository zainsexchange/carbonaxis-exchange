# CarbonAxis backend environment (copy to .env on Render / local — never commit)

PORT=5000
MONGO_URI=mongodb+srv://USER:PASS@cluster.example/carbonaxis
JWT_SECRET=change-me-long-random

# Create admin: set these then run: npm run create-admin
ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.com
ADMIN_BOOTSTRAP_PASSWORD=use-a-long-unique-password

# Email (broker + deal alerts)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=you@example.com
EMAIL_PASS=your-app-password

# Green Energy AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public site URL (Stripe redirects)
SITE_URL=https://www.carbonaxisexchange.com

# Stripe billing (Pro checkout)
# 1) Create a Product + recurring Price in Stripe Dashboard
# 2) Paste the Price ID (price_...) as STRIPE_PRICE_PRO
# 3) Add webhook endpoint: https://carbonaxis-exchange.onrender.com/api/billing/webhook
#    Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=price_xxx
# Optional — Enterprise is contact-sales by default
STRIPE_PRICE_ENTERPRISE=

# Testing only — allows POST /api/subscription/set without Stripe
ALLOW_PLAN_SELF_SERVE=false
